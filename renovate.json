{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>adfinis/renovate-config",
    "github>adfinis/renovate-config:app",
    "github>adfinis/renovate-config:quiet",
    "github>adfinis/renovate-config:lockfile-maintenance",
    "github>projectpotos/renovate-config:potos-deps"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Python tools run with uvx <package>==<version> in the workflows",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "uvx (?<depName>[A-Za-z0-9_.-]+)==(?<currentValue>[0-9][^\\s'\"]*)"
      ],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ]
}
